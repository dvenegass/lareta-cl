# Copia este archivo como .env y ajusta los valores.

# "config.settings.dev" en local, "config.settings.prod" en producción.
DJANGO_SETTINGS_MODULE=config.settings.dev

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgres://juntas:juntas@localhost:5432/juntas

TIME_ZONE=America/Santiago

# Orígenes desde los que el navegador hace peticiones (el frontend).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Dirección del frontend, para los enlaces de los emails (p. ej. "olvidé mi contraseña").
FRONTEND_URL=http://localhost:5173

# Envío de emails. Si no se define, se imprimen en la consola de Django (ideal en desarrollo).
# Ejemplo con Gmail (requiere una "contraseña de aplicación"):
# EMAIL_URL=smtp+tls://tu_correo%40gmail.com:contraseña_de_aplicacion@smtp.gmail.com:587
# DEFAULT_FROM_EMAIL=lareta.cl <tu_correo@gmail.com>

# GIFs del chat: crea una clave gratis en https://partner.klipy.com y pégala aquí.
# Sin clave, el chat funciona igual pero sin el buscador de GIFs.
# KLIPY_API_KEY=tu_clave_de_klipy
